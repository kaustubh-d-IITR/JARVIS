# JARVIS — Environment Variables Template

# 1. Gemini Vision AI (Multimodal Perception)
# Get this from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# 2. Groq API Key (Conversational Brain)
# Get this from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# 3. Deepgram API Key (Voice transcription)
# Get this from https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key

# 4. Spotify Credentials (Action Layer)
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8501/callback

# 5. OpenWeather API Key (Weather Context)
# Get this from https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key

# 6. Location Configuration
LOCATION=New Delhi
