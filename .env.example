# JARVIS — Environment Variables Template

# User AI Keys (Gemini, Groq, Deepgram, OpenRouter) are now provided via the UI.
# Do NOT put them in this .env file.

# 1. Spotify Credentials (Action Layer)
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8501/callback

# 5. OpenWeather API Key (Weather Context)
# Get this from https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key

# 6. Location Configuration
LOCATION=New Delhi
